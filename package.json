{
  "name": "fitness-hub",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "android:init": "cap add android && npm run android:assets && npm run android:sync",
    "android:assets": "capacitor-assets generate --android --assetPath resources",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "vite": "^6.4.5",
    "typescript": "5.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.0",
    "tesseract.js": "^6.0.1",
    "@capacitor/core": "^7.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/assets": "^3.0.5"
  }
}
